# Copy to .env and fill in before deploying. Never commit the real .env.
PRIVATE_KEY=
# Optional: a second funded key so the demo cycle has a real caller address
# distinct from the provider/deployer, instead of one address playing both roles.
PRIVATE_KEY_CALLER=
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io

# Not read from here — pass it inline on the command itself when you're ready,
# e.g. `CONFIRM_MAINNET=yes npm run demo:mainnet`. Any deploy/cycle/demo script
# run with --network arcMainnet refuses to sign anything without it.
# CONFIRM_MAINNET=yes
