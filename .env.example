# Copy to .env and fill in before deploying. Never commit the real .env.
PRIVATE_KEY=
# Optional: a second funded key so the demo cycle has a real caller address
# distinct from the provider/deployer, instead of one address playing both roles.
PRIVATE_KEY_CALLER=
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io
